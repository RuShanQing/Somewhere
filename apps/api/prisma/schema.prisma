// Somewhere 数据模型
// TASK-001：用户与会话；TASK-003：城市目录与最小个人资料；TASK-004：明信片与草稿。
// 其他业务表必须在对应任务中通过显式迁移新增。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReceptionMode {
  OPEN
  RESTING
  CLOSED
}

enum PostcardStatus {
  IN_TRANSIT
  DELIVERED
  RESTRICTED
}

enum UserRole {
  USER
  ADMIN
}

enum StoryReviewStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  REMOVED
}

enum StoryRemovedBy {
  AUTHOR
  MODERATOR
}

enum StoryReviewDecision {
  APPROVE
  REJECT
  REMOVE
}

enum StoryReviewReason {
  PRIVACY
  CONTACT_INFO
  HARASSMENT
  ILLEGAL
  OTHER
}

enum PassageKind {
  ONE_OFF
  ONGOING
  SEASONAL
}

enum PassageProgressStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum PassageConsentState {
  ALLOW
  PAUSED
  CLOSED
}

enum PassageEventType {
  CREATED
  PAUSED
  RESUMED
  COMPLETED
  ARCHIVED
}

enum PenpalConsentState {
  ALLOW
  REVOKED
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  emailNormalized    String              @unique @map("email_normalized") @db.VarChar(254)
  passwordHash       String              @map("password_hash") @db.VarChar(255)
  nickname           String              @db.VarChar(32)
  role               UserRole            @default(USER)
  adultConfirmedAt   DateTime            @map("adult_confirmed_at") @db.Timestamptz(3)
  emailVerifiedAt    DateTime?           @map("email_verified_at") @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions           Session[]
  profile            Profile?
  sentPostcards      Postcard[]          @relation("PostcardSender")
  receivedPostcards  Postcard[]          @relation("PostcardReceiver")
  draftOwner         PostcardDraft[]     @relation("DraftOwner")
  draftRecipient     PostcardDraft[]     @relation("DraftRecipient")
  authoredStories    Story[]             @relation("StoryAuthor")
  reviewedStories    Story[]             @relation("StoryReviewer")
  storyReviewActions StoryReviewAction[]
  passageParts       PassageParticipant[] @relation("PassageParticipant")
  passageEvents      PassageEvent[]       @relation("PassageEventActor")
  blocksCreated      UserBlock[]          @relation("UserBlockBlocker")
  blocksReceived     UserBlock[]          @relation("UserBlockBlocked")
  personalMemories   PersonalMemory[]
  penpalConsentsGiven    PenpalConsent[] @relation("PenpalConsentOwner")
  penpalConsentsReceived PenpalConsent[] @relation("PenpalConsentCounterpart")

  @@map("users")
}

model Session {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  sessionHash String    @unique @map("session_hash") @db.Char(64)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model City {
  id                   String     @id @default(uuid()) @db.Uuid
  name                 String     @db.VarChar(80)
  countryCode          String     @map("country_code") @db.Char(2)
  centroidLat          Float      @map("centroid_lat")
  centroidLon          Float      @map("centroid_lon")
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  profiles             Profile[]
  postcardsOrigin      Postcard[] @relation("PostcardOrigin")
  postcardsDestination Postcard[] @relation("PostcardDestination")
  stories              Story[]

  @@unique([name, countryCode])
  @@index([countryCode])
  @@map("cities")
}

model Profile {
  userId        String        @id @map("user_id") @db.Uuid
  cityId        String?       @map("city_id") @db.Uuid
  receptionMode ReceptionMode @default(OPEN) @map("reception_mode")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  city          City?         @relation(fields: [cityId], references: [id], onDelete: SetNull)

  @@index([cityId])
  @@map("profiles")
}

model PostcardDraft {
  id                String   @id @default(uuid()) @db.Uuid
  ownerId           String   @map("owner_id") @db.Uuid
  recipientId       String?  @map("recipient_id") @db.Uuid
  passageId         String?  @map("passage_id") @db.Uuid
  replyToPostcardId String?  @map("reply_to_postcard_id") @db.Uuid
  body              String   @db.VarChar(2000)
  sentPostcardId    String?  @unique @map("sent_postcard_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner        User      @relation("DraftOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  recipient    User?     @relation("DraftRecipient", fields: [recipientId], references: [id], onDelete: SetNull)
  passage      Passage?  @relation("DraftPassage", fields: [passageId], references: [id], onDelete: Restrict)
  replyTo      Postcard? @relation("DraftReplyTarget", fields: [replyToPostcardId], references: [id], onDelete: Restrict)
  sentPostcard Postcard? @relation("DraftSentPostcard", fields: [sentPostcardId], references: [id], onDelete: Restrict)

  @@index([ownerId, updatedAt])
  @@index([recipientId])
  @@index([passageId])
  @@index([replyToPostcardId])
  @@map("postcard_drafts")
}

model Postcard {
  id                String         @id @default(uuid()) @db.Uuid
  senderId          String         @map("sender_id") @db.Uuid
  receiverId        String         @map("receiver_id") @db.Uuid
  passageId         String?        @map("passage_id") @db.Uuid
  replyToPostcardId String?        @map("reply_to_postcard_id") @db.Uuid
  body              String         @db.VarChar(2000)
  status            PostcardStatus @default(IN_TRANSIT)
  originCityId      String         @map("origin_city_id") @db.Uuid
  destinationCityId String         @map("destination_city_id") @db.Uuid
  sentAt            DateTime       @map("sent_at") @db.Timestamptz(3)
  deliverAt         DateTime       @map("deliver_at") @db.Timestamptz(3)
  deliveredAt       DateTime?      @map("delivered_at") @db.Timestamptz(3)
  idempotencyKey    String?        @map("idempotency_key") @db.VarChar(80)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  sender          User            @relation("PostcardSender", fields: [senderId], references: [id], onDelete: Restrict)
  receiver        User            @relation("PostcardReceiver", fields: [receiverId], references: [id], onDelete: Restrict)
  passage         Passage?        @relation("PostcardPassage", fields: [passageId], references: [id], onDelete: Restrict)
  originCity      City            @relation("PostcardOrigin", fields: [originCityId], references: [id], onDelete: Restrict)
  destinationCity City            @relation("PostcardDestination", fields: [destinationCityId], references: [id], onDelete: Restrict)
  sourceDraft     PostcardDraft?  @relation("DraftSentPostcard")
  replyTo         Postcard?       @relation("PostcardReply", fields: [replyToPostcardId], references: [id], onDelete: Restrict)
  replies         Postcard[]      @relation("PostcardReply")
  replyDrafts     PostcardDraft[] @relation("DraftReplyTarget")
  diaryAsLeft     DiaryPage[]     @relation("DiaryLeft")
  diaryAsRight    DiaryPage[]     @relation("DiaryRight")

  @@unique([senderId, idempotencyKey])
  @@unique([replyToPostcardId])
  @@index([receiverId, status, deliverAt])
  @@index([status, deliverAt])
  @@index([senderId, status])
  @@index([passageId])
  @@map("postcards")
}

model Story {
  id              String            @id @default(uuid()) @db.Uuid
  authorId        String            @map("author_id") @db.Uuid
  cityId          String            @map("city_id") @db.Uuid
  title           String            @db.VarChar(80)
  body            String            @db.VarChar(3000)
  topicTags       String[]          @default([]) @map("topic_tags")
  reviewStatus    StoryReviewStatus @default(DRAFT) @map("review_status")
  publicConsentAt DateTime?         @map("public_consent_at") @db.Timestamptz(3)
  submittedAt     DateTime?         @map("submitted_at") @db.Timestamptz(3)
  reviewedAt      DateTime?         @map("reviewed_at") @db.Timestamptz(3)
  reviewedById    String?           @map("reviewed_by_id") @db.Uuid
  publishedAt     DateTime?         @map("published_at") @db.Timestamptz(3)
  archivedAt      DateTime?         @map("archived_at") @db.Timestamptz(3)
  removedBy       StoryRemovedBy?   @map("removed_by")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  author        User                @relation("StoryAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  city          City                @relation(fields: [cityId], references: [id], onDelete: Restrict)
  reviewedBy    User?               @relation("StoryReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewActions StoryReviewAction[]

  @@index([reviewStatus, submittedAt])
  @@index([reviewStatus, cityId, publishedAt])
  @@index([authorId, createdAt])
  @@map("stories")
}

model StoryReviewAction {
  id          String              @id @default(uuid()) @db.Uuid
  storyId     String              @map("story_id") @db.Uuid
  moderatorId String              @map("moderator_id") @db.Uuid
  action      StoryReviewDecision
  reasonCode  StoryReviewReason?  @map("reason_code")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  story     Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  moderator User  @relation(fields: [moderatorId], references: [id], onDelete: Restrict)

  @@index([storyId, createdAt])
  @@index([moderatorId, createdAt])
  @@map("story_review_actions")
}

model Passage {
  id             String                @id @default(uuid()) @db.Uuid
  topic          String                @db.VarChar(80)
  kind           PassageKind
  progressStatus PassageProgressStatus @default(ACTIVE) @map("progress_status")
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  completedAt    DateTime?             @map("completed_at") @db.Timestamptz(3)
  archivedAt     DateTime?             @map("archived_at") @db.Timestamptz(3)

  participants PassageParticipant[]
  events       PassageEvent[]
  drafts       PostcardDraft[]      @relation("DraftPassage")
  postcards    Postcard[]           @relation("PostcardPassage")
  diaryPages   DiaryPage[]          @relation("PassageDiaryPages")

  @@index([progressStatus, updatedAt])
  @@map("passages")
}

model PassageParticipant {
  passageId       String               @map("passage_id") @db.Uuid
  userId          String               @map("user_id") @db.Uuid
  consentState    PassageConsentState  @default(ALLOW) @map("consent_state")
  pausedAt        DateTime?            @map("paused_at") @db.Timestamptz(3)
  lastConfirmedAt DateTime?            @map("last_confirmed_at") @db.Timestamptz(3)

  passage Passage @relation(fields: [passageId], references: [id], onDelete: Restrict)
  user    User    @relation("PassageParticipant", fields: [userId], references: [id], onDelete: Restrict)

  @@id([passageId, userId])
  @@index([userId, passageId])
  @@map("passage_participants")
}

model PassageEvent {
  id               String           @id @default(uuid()) @db.Uuid
  passageId        String           @map("passage_id") @db.Uuid
  actorId          String           @map("actor_id") @db.Uuid
  eventType        PassageEventType @map("event_type")
  metadataRedacted Json?            @map("metadata_redacted")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  passage Passage @relation(fields: [passageId], references: [id], onDelete: Restrict)
  actor   User    @relation("PassageEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([passageId, createdAt])
  @@map("passage_events")
}

model UserBlock {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  blocker User @relation("UserBlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("UserBlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId, createdAt])
  @@map("user_blocks")
}

/// 个人记忆：只归本人所有；本任务不提供公开、共享或来源引用字段。
model PersonalMemory {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  title     String   @db.VarChar(80)
  body      String   @db.VarChar(3000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, updatedAt(sort: Desc), id(sort: Desc)])
  @@map("personal_memories")
}

model PenpalConsent {
  ownerId       String             @map("owner_id") @db.Uuid
  counterpartId String             @map("counterpart_id") @db.Uuid
  consentState  PenpalConsentState @default(ALLOW) @map("consent_state")
  consentedAt   DateTime?          @map("consented_at") @db.Timestamptz(3)
  revokedAt     DateTime?          @map("revoked_at") @db.Timestamptz(3)

  owner       User @relation("PenpalConsentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  counterpart User @relation("PenpalConsentCounterpart", fields: [counterpartId], references: [id], onDelete: Cascade)

  @@id([ownerId, counterpartId])
  @@index([counterpartId, consentState])
  @@map("penpal_consents")
}

/// 双城日记：一页只引用两封已送达的明信片；正文仍只存于 postcards，不复制。
model DiaryPage {
  id              String   @id @default(uuid()) @db.Uuid
  passageId       String   @map("passage_id") @db.Uuid
  postcardLeftId  String   @map("postcard_left_id") @db.Uuid
  postcardRightId String   @map("postcard_right_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  passage       Passage  @relation("PassageDiaryPages", fields: [passageId], references: [id], onDelete: Restrict)
  postcardLeft  Postcard @relation("DiaryLeft", fields: [postcardLeftId], references: [id], onDelete: Restrict)
  postcardRight Postcard @relation("DiaryRight", fields: [postcardRightId], references: [id], onDelete: Restrict)

  @@unique([postcardLeftId, postcardRightId])
  @@index([passageId, createdAt(sort: Desc)])
  @@map("diary_pages")
}
