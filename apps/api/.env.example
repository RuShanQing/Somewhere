# 本地开发专用配置示例（全部为虚构值，禁止把真实凭据写入仓库）
NODE_ENV=development
PORT=4301

# 开发数据库（Docker/本地 PostgreSQL 均可，见 infra/postgres）
DATABASE_URL=postgresql://somewhere:somewhere_dev_pw@localhost:5432/somewhere_dev?schema=public
# 集成测试专用数据库，库名必须包含 "test"
TEST_DATABASE_URL=postgresql://somewhere:somewhere_dev_pw@localhost:5432/somewhere_test?schema=public

# 允许携带 Cookie 发起写请求的前端来源（CSRF / Origin 校验）
WEB_ORIGINS=http://localhost:5273,http://127.0.0.1:5273

# 会话 Cookie（NODE_ENV=production 时自动 Secure；HTTPS 预发布可用 COOKIE_SECURE=true 强制）
SESSION_COOKIE_NAME=sw_session
SESSION_TTL_HOURS=168
# COOKIE_SECURE=true

# 认证限流（窗口内的最大请求数）
AUTH_REGISTER_MAX_PER_IP=10
AUTH_REGISTER_WINDOW_MS=3600000
AUTH_LOGIN_MAX_PER_IP=30
AUTH_LOGIN_MAX_PER_IDENTITY=10
AUTH_LOGIN_WINDOW_MS=300000

# 仅本地 seed 使用；生产环境不会执行 seed
SEED_USER_EMAIL=demo@example.test
SEED_USER_PASSWORD=demo-somewhere-2026
SEED_USER_NICKNAME=示例旅人

# 邮局演示收件人白名单：只列出这些已注册账号，不开放用户搜索。
# 请把下面地址改成你本机演示账号的邮箱；多个用英文逗号分隔。
POSTCARD_DEMO_RECIPIENT_EMAILS=demo.recipient@example.test

# 每账号滚动 24 小时最多成功寄出的明信片数量。
POSTCARD_MAX_SENDS_PER_DAY=10

# 独立 Worker 扫描到期明信片的间隔（毫秒）。
DELIVERY_POLL_INTERVAL_MS=60000
